# Copy this file to backend/.env and replace values.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_PLACES_ENDPOINT=https://maps.googleapis.com/maps/api/place
MAP_PROVIDER=openstreetmap
MAP_STYLE=default
DATABASE_URL=sqlite:///./aitinerary.db
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
